{
  "name": "getraw",
  "version": "0.4.0",
  "description": "Fast media downloader CLI built natively in Bun/TypeScript",
  "type": "module",
  "bin": {
    "getraw": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "bun test",
    "build": "bun build src/cli/index.ts --target=node --outfile=dist/index.js",
    "build:binary": "bun build src/cli/index.ts --compile --outfile=getraw",
    "prepublishOnly": "bun run build",
    "dashboard": "bun run tools/dashboard.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "googlevideo": "^4.0.4",
    "hls-parser": "^0.13.6",
    "meriyah": "^6.0.7",
    "mpd-parser": "^1.3.0",
    "youtubei.js": "^17.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/onkits/getraw"
  }
}
